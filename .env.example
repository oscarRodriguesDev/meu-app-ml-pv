# Nunca comite valores reais. As quatro variáveis de API já existem no ambiente.
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=901717874275
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# URL EXATA cadastrada na aplicação do Mercado Livre; HTTPS em produção.
ML_REDIRECT_URI=http://localhost:3000/api/oauth/callback
# Supabase: copie Connect > Session pooler (5432), nunca Transaction (6543).
# postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ml_clickup
# Opcional: certificado CA PEM do Supabase. Aceita \n literais ou PEM multilinha.
DATABASE_SSL_CA=
# openssl rand -base64 32 (uma chave AES de 32 bytes)
TOKEN_ENCRYPTION_KEY=
# openssl rand -hex 32 (dois segredos distintos)
ADMIN_SECRET=
CRON_SECRET=
# Opcional: restringir a conexão a um vendedor específico.
ML_SELLER_ID=
# Marco inicial da primeira busca. Depois é usado o checkpoint com sobreposição.
ML_SYNC_FROM=2000-01-01T00:00:00.000Z
