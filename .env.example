# Supabase via HTTPS. Não é necessário DATABASE_URL nem acesso TCP.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Exclusiva do servidor, nunca em NEXT_PUBLIC_* nem no navegador.
SUPABASE_SECRET_KEY=
# Opcional; por padrão é derivada de SUPABASE_URL. Reservada para uso com Supabase Auth.
SUPABASE_JWKS_URL=https://SEU_PROJETO.supabase.co/auth/v1/.well-known/jwks.json
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=901717874275
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:3000/api/oauth/callback
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Dois segredos distintos: openssl rand -hex 32
ADMIN_SECRET=
CRON_SECRET=
ML_SELLER_ID=
ML_SYNC_FROM=2000-01-01T00:00:00.000Z
